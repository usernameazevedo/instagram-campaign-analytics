# Token de acesso da Meta (Graph API) - gerar em https://developers.facebook.com/tools/explorer
# Permissões necessárias: instagram_basic, business_management, pages_show_list, pages_read_engagement
ACCESS_TOKEN=

# Username da conta Instagram Business sua (vinculada a uma Página do Facebook)
OWN_IG_USERNAME=

# Conta-alvo padrão para análise (pode sobrescrever via argumento de linha de comando)
TARGET_USERNAME=perfil_alvo
